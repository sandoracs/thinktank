# Roundtable configuration — copy to `.env` and uncomment what you need.
# All app settings are prefixed ROUNDTABLE_ (see src/roundtable/config.py).

# --- storage ---
# ROUNDTABLE_DATABASE_URL=sqlite+aiosqlite:///./roundtable.db
# ROUNDTABLE_DATA_DIR=data

# --- hub ---
# ROUNDTABLE_HOST=127.0.0.1
# ROUNDTABLE_PORT=8080
# ROUNDTABLE_ADMIN_TOKEN=

# --- LLM (LiteLLM model strings; provider keys below come from the shell/.env) ---
# ROUNDTABLE_DEFAULT_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# For local models: ROUNDTABLE_DEFAULT_MODEL=ollama/qwen2.5 (run Ollama locally)
# Remote Ollama server: OLLAMA_API_BASE=http://192.168.x.x:11434
# (Ollama thinking models run with think=false automatically)

# --- offline mode: hub + runs use the deterministic FakeLLM, no API calls ---
# ROUNDTABLE_FAKE_LLM=1

# --- embeddings (memory search) ---
# "fake" = deterministic hash-based (offline, lexical-quality search)
# "litellm" = real model via Ollama / hosted API (multilingual, good for Hungarian)
# ROUNDTABLE_EMBEDDING_BACKEND=fake
# ROUNDTABLE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# ROUNDTABLE_EMBEDDING_DIM=384
# NOTE: DIM must match the model's output size. After switching models on an
# existing DB, run: uv run roundtable reembed

# --- logging ---
# ROUNDTABLE_LOG_LEVEL=INFO
# ROUNDTABLE_LOG_JSON=true
