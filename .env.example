# ThinkTank configuration — copy to `.env` and uncomment what you need.
# All app settings are prefixed THINKTANK_ (see src/thinktank/config.py).

# --- storage ---
# THINKTANK_DATABASE_URL=sqlite+aiosqlite:///./thinktank.db
# THINKTANK_DATA_DIR=data

# --- hub (the hub has no authentication; keep it on loopback) ---
# THINKTANK_HOST=127.0.0.1
# THINKTANK_PORT=8080
# Host names the hub answers to (DNS-rebinding guard); add a LAN name/IP if exposed, * = off
# THINKTANK_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- LLM (LiteLLM model strings; provider keys below come from the shell/.env) ---
# THINKTANK_DEFAULT_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# For local models: THINKTANK_DEFAULT_MODEL=ollama/qwen2.5 (run Ollama locally)
# Remote Ollama server: OLLAMA_API_BASE=http://192.168.x.x:11434
# (Ollama thinking models run with think=false automatically)
# Custom endpoints (OpenAI-compatible, Azure, …) can be registered in the
# web hub instead: Settings → "LLM providers" (stored in
# <data_dir>/llm_providers.json, used as <id>/<model>).

# --- offline mode: hub + runs use the deterministic FakeLLM, no API calls ---
# THINKTANK_FAKE_LLM=1

# --- embeddings (memory search) ---
# "fake" = deterministic hash-based (offline, lexical-quality search)
# "litellm" = real model via Ollama / hosted API (multilingual, good for Hungarian)
# THINKTANK_EMBEDDING_BACKEND=fake
# THINKTANK_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# THINKTANK_EMBEDDING_DIM=384
# NOTE: DIM must match the model's output size. After switching models on an
# existing DB, run: uv run thinktank reembed

# --- logging ---
# --- agent context budget (estimated tokens per turn) ---
# THINKTANK_CONTEXT_TOTAL_TOKENS=16000
# THINKTANK_CONTEXT_SYSTEM_TOKENS=3000   # persona+rules soft cap (warns, never fails)
# THINKTANK_CONTEXT_MEMORY_TOKENS=1500
# THINKTANK_CONTEXT_SUMMARY_TOKENS=1500

# THINKTANK_LOG_LEVEL=INFO
# THINKTANK_LOG_JSON=true
